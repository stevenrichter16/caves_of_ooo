+                for(int dx=-1;dx<=1;dx++)for(int dy=-1;dy<=1;dy++)
+                {var c=zone.GetCell(seat.X+dx,seat.Y+dy);if(c!=null&&!c.BlocksMovement()&&c!=landing&&c!=seat)impostorSeat=c;}
