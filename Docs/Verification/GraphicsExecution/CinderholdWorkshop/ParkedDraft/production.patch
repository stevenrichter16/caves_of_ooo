+        /// <summary>Neutral frame for the bounded ordinary Cinderhold forge.
+        /// The caller supplies current site, placement and disclosure authority.
+        /// Keep the established East resolver and its memory policy independent.</summary>
+        internal bool TryResolveOrdinaryForge(Entity owner, out Tile tile)
+        {
+            tile = null;
+            if (_disposed || _tiles == null || owner?.BlueprintName != "TinkersForge"
+                || owner.Tags == null || owner.Tags.Count != 2
+                || !owner.HasTag("Furniture") || !owner.HasTag("Weaponcraft")) return false;
+            var r = Unique<RenderPart>(owner); var p = Unique<PhysicsPart>(owner);
+            if (r == null || p == null || Unique<ForgePart>(owner) == null || Unique<ExaminablePart>(owner) == null
+                || !r.Visible || r.RenderString != "n" || r.ColorString != "&R" || r.RenderLayer != 5
+                || !string.IsNullOrEmpty(r.BackgroundColor) || !string.IsNullOrEmpty(r.DetailColor)
+                || !string.IsNullOrEmpty(r.TileColor) || !string.IsNullOrEmpty(r.Tile)
+                || !string.IsNullOrEmpty(r.VisualID) || !string.IsNullOrEmpty(r.VisualVariant)
+                || !string.IsNullOrEmpty(r.GlyphVariants) || p.Solid || p.Takeable
+                || p.InInventory != null || p.Equipped != null) return false;
+            // Unknown parts may add a service, hazard or authored appearance.
+            // Such owners retain their glyph rather than borrowing a neutral body.
+            foreach (var part in owner.Parts)
+            {
+                if (part == null || part.ParentEntity != owner) return false;
+                var type = part.GetType();
+                if (type == typeof(RenderPart) || type == typeof(PhysicsPart)
+                    || type == typeof(ForgePart) || type == typeof(ExaminablePart)) continue;
+                if (type == typeof(StackerPart))
+                { if (Unique<StackerPart>(owner)?.StackCount > 0) continue; return false; }
+                if (type == typeof(SpatialFootprintPart))
+                { if (Unique<SpatialFootprintPart>(owner) != null && SingleCell(owner)) continue; return false; }
+                if (type == typeof(StatusEffectsPart))
+                { if (Unique<StatusEffectsPart>(owner) != null) continue; return false; }
+                return false;
+            }
+            tile = _tiles[0]; return true;
+        }
