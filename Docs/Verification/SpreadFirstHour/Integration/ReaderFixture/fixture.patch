+        // These four reader assertions concern visible world owners. The old
+        // bare entities had no RenderPart and the cell was unexplored/unseen;
+        // production correctly refuses that context instead of leaking prose.
+        private static InputHandler BuildVisibleExamineInput(Entity player, Zone zone)
+        {
+            var cell = zone.GetCell(11, 10);
+            cell.IsVisible = cell.Explored = true;
+            foreach (var owner in cell.Occupants)
+                owner.AddPart(new RenderPart { Visible = true });
+            var input = BuildInputHandler(player, zone);
+            // Owned by the existing input teardown, never a leaked modal root.
+            input.AnnouncementUI = input.gameObject.AddComponent<AnnouncementUI>();
+            // A free-reader fixture needs local energy/time, not a published Active manager.
+            var turns = (TurnManager)Activator.CreateInstance(typeof(TurnManager),
+                BindingFlags.Instance | BindingFlags.NonPublic, null, new object[] { false }, null);
+            turns.AddEntity(player); turns.ProcessUntilPlayerTurn(); input.TurnManager = turns;
+            return input;
+        }
+
+        private static string ExamineInReader(InputHandler input)
+        {
+            var menu = input.WorldActionMenuUI;
+            var actions = GetMenuActions(menu);
+            int index = actions.FindIndex(a => a.Command == "Examine");
+            Assert.GreaterOrEqual(index, 0, "The actual current menu must offer Examine.");
+            var action = actions[index]; var target = menu.SelectedTarget;
+            var cell = menu.SelectedCell; bool pile = menu.SelectedCellIsPile;
+            int tick = input.TurnManager.TickCount, energy = input.TurnManager.GetEnergy(input.PlayerEntity);
+            int hp = input.PlayerEntity.GetStatValue("Hitpoints"), version = input.CurrentZone.EntityVersion;
+            var owners = new List<Entity>(input.CurrentZone.GetReadOnlyEntities());
+            InvokeNonPublic(menu, "SelectAction", index);
+            InvokeNonPublic(input, "ExecuteWorldActionSelection", action, target, cell, pile);
+            var reader = input.AnnouncementUI;
+            Assert.IsTrue(reader.IsOpen, "World Examine uses the actual complete reader.");
+            Assert.AreEqual("AnnouncementOpen", GetInputState(input));
+            var lines = new List<string>();
+            for (int page = 0; page < reader.PageCount; page++)
+            { Assert.IsTrue(reader.GoToPage(page)); lines.AddRange(reader.VisibleLines); }
+            string text = string.Join(" ", lines).Trim();
+            reader.Close(); InvokeNonPublic(input, "CloseAnnouncement");
+            Assert.AreEqual("Normal", GetInputState(input));
+            Assert.IsFalse(reader.IsOpen); Assert.IsFalse(MessageLog.HasPendingAnnouncement);
+            Assert.AreEqual(tick, input.TurnManager.TickCount);
+            Assert.AreEqual(energy, input.TurnManager.GetEnergy(input.PlayerEntity));
+            Assert.AreEqual(hp, input.PlayerEntity.GetStatValue("Hitpoints"));
+            Assert.AreEqual(version, input.CurrentZone.EntityVersion);
+            CollectionAssert.AreEqual(owners, input.CurrentZone.GetReadOnlyEntities());
+            return text;
+        }
+
