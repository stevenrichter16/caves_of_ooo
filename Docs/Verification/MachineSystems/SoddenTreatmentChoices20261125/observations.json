  "Conversation": {
    "ID": "Supplies",
    "text": "'A sumpsieve pad alone draws ordinary poison or gas poison. You can knot a cord into a bandage to stop bleeding. If the bench legs are split, brace them with two salvaged timber. Bring one sumpsieve pad, one knotflax cord and two drams while I am at the bench. I can make a dressing that treats ordinary poison and bleeding in one action. It won't heal wounds or treat gas poison or fungal infection. You can keep it for the road.'",
    "speaker": "5335",
    "choices": [
      {
        "i": 0,
        "Text": "Something else.",
        "Target": "Start"
      },
      {
        "i": 1,
        "Text": "I will look at the bench.",
        "Target": "End"
      },
      {
        "i": 2,
        "Text": "[Let's trade.]",
        "Target": "End"
      },
      {
        "i": 3,
        "Text": "[Attack]",
        "Target": "End"
      }
    ],
    "tick": 2000
  },
