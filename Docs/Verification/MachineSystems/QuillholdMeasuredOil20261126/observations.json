  "oilOldPitch": {
    "t": 2230,
    "active": true,
    "speaker": "6999",
    "dialog": "Scribe_1",
    "node": "concern:pitch|quillhold.lamps",
    "text": "The record of the copy-room has it that we work until the lamps go out. The lamps went out in spring. We copy by the windows now and lose the evenings. Three flasks of lamp oil and the desks are lit again. Failing oil: if your eyes are better than ours, sit with the conservators' condition report on the First Account and collate it. The last hand stopped mid-line.\n\n- Bring three flasks of lamp oil for the copy-room lamps.\n\n- Read the condition report on the First Account and carry the collation back.",
    "choices": [
      {
        "Text": "[I'll see to it.]",
        "actions": [
          {
            "Key": "AcceptConcern",
            "Value": "quillhold.lamps"
          }
        ]
      },
      {
        "Text": "[I can't take the copy-room on. I'm saying so now.]",
        "actions": [
          {
            "Key": "RefuseConcern",
            "Value": "quillhold.lamps"
          }
        ]
      },
      {
        "Text": "[Back]",
        "actions": null
      },
      {
        "Text": "[Let's trade.]",
        "actions": [
          {
            "Key": "StartTrade",
            "Value": ""
          }
        ]
      },
      {
        "Text": "[Attack]",
        "actions": [
          {
            "Key": "StartAttack",
            "Value": ""
          }
        ]
      }
    ],
    "oil": 3,
    "kind": "oil"
  },
