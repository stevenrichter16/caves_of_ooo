  "code": "var library=CavesOfOoo.Rendering.SpreadBiomeHumanoidLibrary.Load();var rows=new System.Collections.Generic.List<object>();\nforeach(var entry in library.Entries){\nvar mesh=entry.Mesh;using(var stream=new System.IO.MemoryStream()){using(var writer=new System.IO.BinaryWriter(stream)){\nforeach(var v in mesh.vertices){writer.Write(v.x);writer.Write(v.y);writer.Write(v.z);}foreach(var v in mesh.normals){writer.Write(v.x);writer.Write(v.y);writer.Write(v.z);}foreach(var v in mesh.uv){writer.Write(v.x);writer.Write(v.y);}foreach(var w in mesh.boneWeights){writer.Write(w.boneIndex0);writer.Write(w.boneIndex1);writer.Write(w.boneIndex2);writer.Write(w.boneIndex3);writer.Write(w.weight0);writer.Write(w.weight1);writer.Write(w.weight2);writer.Write(w.weight3);}foreach(var m in mesh.bindposes)for(int n=0;n<16;n++)writer.Write(m[n]);foreach(var n in mesh.triangles)writer.Write(n);writer.Flush();using(var sha=System.Security.Cryptography.SHA256.Create())rows.Add(new{id=entry.Id,vertices=mesh.vertexCount,shapeAndUv0Hash=System.BitConverter.ToString(sha.ComputeHash(stream.ToArray())).Replace(\"-\",\"\").ToLowerInvariant(),markers=mesh.uv2.Length});}}}\nreturn rows;"
