   [Test]public void SavedCachedRoomDoesNotRegenerateDestroyedStairsOrLoot(){var m=OverworldZoneManager.CreateDetached(scope.Factory,64);var z=m.GetZone(RoomId(m,7));m.SetActiveZone(z);foreach(var e in z.GetReadOnlyEntities().Where(e=>e.HasPart<StairsUpPart>()||e.HasPart<StairsDownPart>()).ToArray())z.RemoveEntity(e);var container=z.GetReadOnlyEntities().FirstOrDefault(e=>e.HasPart<ContainerPart>());if(container!=null)container.GetPart<ContainerPart>().Contents.Clear();var player=scope.Factory.CreateEntity("Player");var c=z.GetReadOnlyEntities().Select(e=>z.GetEntityCell(e)).First(cell=>!cell.BlocksMovement());z.AddEntity(player,c.X,c.Y);int count=z.EntityCount;var oldTurns=TurnManager.Active;try{var turns=new TurnManager();turns.RestoreSavedState(0,true,player,new List<TurnManager.SavedTurnEntry>{new TurnManager.SavedTurnEntry{Entity=player,Energy=1000}});var state=GameSessionState.Capture("underground-layout","test",m,turns,player);using(var stream=new MemoryStream()){state.Save(new SaveWriter(stream));stream.Position=0;var loaded=GameSessionState.Load(new SaveReader(stream,scope.Factory));var saved=loaded.ZoneManager.ActiveZone;Assert.AreSame(saved,loaded.ZoneManager.GetZone(saved.ZoneID));Assert.AreEqual(count,saved.EntityCount);Assert.False(saved.GetReadOnlyEntities().Any(e=>e.HasPart<StairsUpPart>()||e.HasPart<StairsDownPart>()));if(container!=null)Assert.Zero(saved.GetReadOnlyEntities().Single(e=>e.ID==container.ID).GetPart<ContainerPart>().Contents.Count);}}finally{typeof(TurnManager).GetProperty("Active").SetValue(null,oldTurns);}}
   [Test]public void LowerFirstRoomedFloorKeepsTheExistingReciprocalGraph(){var m=OverworldZoneManager.CreateDetached(scope.Factory,64);string id=RoomId(m,7);var lower=m.GetZone(id);var up=lower.GetReadOnlyEntities().Single(e=>e.HasPart<StairsUpPart>());var before=lower.GetEntityCell(up);var parent=m.GetZone(WorldMap.GetZoneAbove(id));Assert.NotNull(parent);var edge=m.GetConnectionsTo(id,"StairsDown").Single();Assert.AreEqual(before.X,edge.TargetX);Assert.AreEqual(before.Y,edge.TargetY);Assert.True(parent.GetCell(edge.SourceX,edge.SourceY).Occupants.Any(e=>e.HasPart<StairsDownPart>()));Assert.AreSame(lower,m.GetZone(id));Assert.AreSame(up,lower.GetReadOnlyEntities().Single(e=>e.HasPart<StairsUpPart>()));}
