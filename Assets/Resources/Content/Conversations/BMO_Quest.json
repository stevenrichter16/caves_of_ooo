                  "Value": "BmoCartridge"
                },
                {
                  "Key": "AwardXP",
                  "Value": "120"
                },
                {
                  "Key": "GiveDrams",
                  "Value": "40"
                }
              ]
            },
            {
              "Text": "[Done] Hello again, Ellun.",
              "Target": "Done",
              "Predicates": [
                {
                  "Key": "IfQuestCompleted",
                  "Value": "BmoCartridge"
                }
              ]
            },
            {
              "Text": "[Release] I won't be finishing this. I wanted to tell you myself.",
              "Target": "Released",
              "Predicates": [
                {
                  "Key": "IfQuestActive",
                  "Value": "BmoCartridge"
                }
              ],
              "Actions": [
                {
                  "Key": "RefuseQuest",
                  "Value": "BmoCartridge"
                }
              ]
            },
            {
              "Text": "Goodbye, Ellun.",
              "Target": "End"
            }
          ]
        },
        {
          "ID": "Accepted",
          "Text": "The pith fell near the old stump. I'll wait here. Mind where you step.",
          "Choices": [
            {
              "Text": "I'll be back.",
              "Target": "End"
            }
          ]
        },
        {
          "ID": "Looking",
          "Text": "Near the old stump. It's small and pale, like a tooth.",
          "Choices": [
            {
              "Text": "All right.",
