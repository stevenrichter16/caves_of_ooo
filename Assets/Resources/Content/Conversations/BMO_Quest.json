                  "Value": "BmoCartridge"
                }
              ]
            },
            {
              "Text": "[Status] Still looking.",
              "Target": "Looking",
              "Predicates": [
                {
                  "Key": "IfQuestStage",
                  "Value": "BmoCartridge:search"
                }
              ]
            },
            {
              "Text": "[Report] Found it, out by the stump.",
              "Target": "Found",
              "Predicates": [
                {
