{"ts":"2026-08-08T17:46:49.519Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1006,"action":"execute","params":{"action":"execute","code":"var overlayTm = default(UnityEngine.Tilemaps.Tilemap);\nforeach (var tm in UnityEngine.Object.FindObjectsByType<UnityEngine.Tilemaps.Tilemap>(UnityEngine.FindObjectsSortMode.None))\n    if (tm.gameObject.name == \"EnvironmentSpriteTilemap\") overlayTm = tm;\nif (overlayTm == null) return \"overlay tilemap not found\";\nvar zr = UnityEngine.Object.FindObjectsByType<CavesOfOoo.Rendering.ZoneRenderer>(UnityEngine.FindObjectsSortMode.None);\nif (zr.Length == 0) return \"no ZoneRenderer\";\nvar prop = zr[0].GetType().GetProperty(\"CurrentZone\") ?? null;\nvar field = zr[0].GetType().GetField(\"CurrentZone\");\nobject zoneObj = prop != null ? prop.GetValue(zr[0]) : (field != null ? field.GetValue(zr[0]) : null);\nvar zone = zoneObj as CavesOfOoo.Core.Zone;\nif (zone == null) return \"zone not resolved from ZoneRenderer\";\nint claims = 0, onUnexplored = 0, onNotVisible = 0, actorInFog = 0;\nvar sb = new System.Text.StringBuilder();\nfor (int x = 0; x < CavesOfOoo.Core.Zone.Width; x++)\nfor (int ty = 0; ty < CavesOfOoo.Core.Zone.Height; ty++)\n{\n    var t = overlayTm.GetTile(new UnityEngine.Vector3Int(x, ty, 0));\n    if (t == null) continue;\n    claims++;\n    int zy = CavesOfOoo.Core.Zone.Height - 1 - ty;\n    var cell = zone.GetCell(x, zy);\n    if (cell == null) continue;\n    if (!cell.Explored) { onUnexplored++; if (onUnexplored <= 5) sb.Append(\"unexplored:\" + t.name + \"@\" + x + \",\" + zy + \" \"); }\n    else if (!cell.IsVisible)\n    {\n        onNotVisible++;\n        string n = t.name;\n        bool actorTile = n == \"Player\" || n == \"Snapjaw\" || n == \"Villager\" || n == \"Merchant\" || n == \"Elder\" || n == \"Warden\" || n == \"VillageChild\" || n == \"Weaponsmith\" || n == \"Armorer\" || n == \"Apothecary\" || n == \"Arcanist\" || n == \"Provisioner\" || n.EndsWith(\"Hermit\");\n        if (actorTile) { actorInFog++; sb.Append(\"ACTOR-IN-FOG:\" + n + \"@\" + x + \",\" + zy + \" \"); }\n    }\n}\nreturn \"claims=\" + claims + \" onUnexplored=\" + onUnexplored + \" onNotVisible=\" + onNotVisible + \" actorInFog=\" + actorInFog + \" :: \" + sb;","safety_checks":true,"compiler":"auto"}}
