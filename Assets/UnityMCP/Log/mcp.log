{"ts":"2026-08-08T17:46:28.880Z","tool":"execute_code","type":"tool","status":"ERROR","ms":1128,"action":"execute","params":{"action":"execute","code":"var grid = UnityEngine.GameObject.Find(\"ZoneTilemap\");\nvar overlayTm = default(UnityEngine.Tilemaps.Tilemap);\nforeach (var tm in UnityEngine.Object.FindObjectsByType<UnityEngine.Tilemaps.Tilemap>(UnityEngine.FindObjectsSortMode.None))\n    if (tm.gameObject.name == \"EnvironmentSpriteTilemap\") overlayTm = tm;\nif (overlayTm == null) return \"overlay tilemap not found\";\nvar zone = CavesOfOoo.Core.ZoneManager.Instance != null ? CavesOfOoo.Core.ZoneManager.Instance.ActiveZone : null;\nif (zone == null) return \"no active zone\";\nint claims = 0, onUnexplored = 0, onNotVisible = 0, actorOnNotVisible = 0;\nvar sb = new System.Text.StringBuilder();\nfor (int x = 0; x < CavesOfOoo.Core.Zone.Width; x++)\nfor (int ty = 0; ty < CavesOfOoo.Core.Zone.Height; ty++)\n{\n    var t = overlayTm.GetTile(new UnityEngine.Vector3Int(x, ty, 0));\n    if (t == null) continue;\n    claims++;\n    int zy = CavesOfOoo.Core.Zone.Height - 1 - ty;\n    var cell = zone.GetCell(x, zy);\n    if (cell == null) continue;\n    if (!cell.Explored) { onUnexplored++; if (onUnexplored <= 5) sb.Append($\"unexplored claim {t.name}@({x},{zy}) \"); }\n    else if (!cell.IsVisible)\n    {\n        onNotVisible++;\n        bool actorTile = t.name == \"Player\" || t.name == \"Snapjaw\" || t.name == \"Villager\" || t.name == \"Merchant\" || t.name == \"Elder\" || t.name == \"Warden\" || t.name == \"VillageChild\" || t.name == \"Weaponsmith\" || t.name == \"Armorer\" || t.name == \"Apothecary\" || t.name == \"Arcanist\" || t.name == \"Provisioner\" || t.name.EndsWith(\"Hermit\");\n        if (actorTile) { actorOnNotVisible++; sb.Append($\"ACTOR-IN-FOG {t.name}@({x},{zy}) \"); }\n    }\n}\nreturn $\"claims={claims} onUnexplored={onUnexplored} onNotVisible={onNotVisible} actorInFog={actorOnNotVisible} :: {sb}\";","safety_checks":true,"compiler":"auto"},"error":"Compilation failed"}
