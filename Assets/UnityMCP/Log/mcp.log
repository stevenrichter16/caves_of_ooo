{"ts":"2026-08-10T03:21:09.312Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":855,"action":"execute","params":{"action":"execute","code":"var gb=UnityEngine.Object.FindObjectsByType<CavesOfOoo.GameBootstrap>(UnityEngine.FindObjectsSortMode.None)[0]; var ff=gb.GetType().GetField(\"_factory\", System.Reflection.BindingFlags.NonPublic|System.Reflection.BindingFlags.Instance); var fac=ff.GetValue(gb) as CavesOfOoo.Data.EntityFactory; System.Func<CavesOfOoo.Core.Zone,string,int,int,CavesOfOoo.Core.Entity> mk = (z,n,x,y) => { var e=new CavesOfOoo.Core.Entity{ID=n,BlueprintName=n}; e.Tags[\"Creature\"]=\"\"; e.Statistics[\"Hitpoints\"]=new CavesOfOoo.Core.Stat{Owner=e,Name=\"Hitpoints\",BaseValue=300,Min=0,Max=300}; e.Statistics[\"ElectricResistance\"]=new CavesOfOoo.Core.Stat{Owner=e,Name=\"ElectricResistance\",BaseValue=0,Min=-100,Max=100}; e.AddPart(new CavesOfOoo.Core.RenderPart{DisplayName=n}); e.AddPart(new CavesOfOoo.Core.StatusEffectsPart()); z.AddEntity(e,x,y); return e; }; System.Func<CavesOfOoo.Core.Zone,CavesOfOoo.Core.FulminationMutation> setup = z => { var c=mk(z,\"caster\",5,5); c.AddPart(new CavesOfOoo.Core.MutationsPart()); var inv=new CavesOfOoo.Core.InventoryPart{MaxWeight=500}; c.AddPart(inv); var b=fac.CreateEntity(\"FulminationGrimoire\"); inv.AddObject(b); var r=new CavesOfOoo.Core.FulminationMutation(); c.AddPart(r); r.Mutate(c,1); return r; }; string res=\"\"; var z1=new CavesOfOoo.Core.Zone(); var r1=setup(z1); mk(z1,\"target\",8,5); var b1=mk(z1,\"bystander\",10,5); int h1=b1.GetStatValue(\"Hitpoints\"); r1.Cast(z1,1,0); res += \"DRY STONE   bystander \"+h1+\" -> \"+b1.GetStatValue(\"Hitpoints\"); var z2=new CavesOfOoo.Core.Zone(); var r2=setup(z2); mk(z2,\"target\",8,5); var b2=mk(z2,\"bystander\",10,5); for(int x=8;x<=10;x++) z2.TileState.WriteCoating(x,5,\"water\",6); int h2=b2.GetStatValue(\"Hitpoints\"); r2.Cast(z2,1,0); res += \"\\nFLOODED     bystander \"+h2+\" -> \"+b2.GetStatValue(\"Hitpoints\"); var z3=new CavesOfOoo.Core.Zone(); var r3=setup(z3); mk(z3,\"target\",8,5); for(int x=8;x<=13;x++){ var g=fac.CreateEntity(\"MetalGrate\"); z3.AddEntity(g,x,5); } var b3=mk(z3,\"far\",12,5); z3.TileState.WriteCoating(12,5,\"water\",6); int h3=b3.GetStatValue(\"Hitpoints\"); r3.Cast(z3,1,0); res += \"\\nGRATED      far(12)   \"+h3+\" -> \"+b3.GetStatValue(\"Hitpoints\"); res += \"\\n\\nsame rite, same cast, three rooms.\"; return res;","safety_checks":true,"compiler":"auto"}}
