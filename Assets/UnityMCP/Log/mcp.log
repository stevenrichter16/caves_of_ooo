{"ts":"2026-08-11T01:49:56.201Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1947,"action":"execute","params":{"action":"execute","code":"var cam = Camera.main;\nif (cam == null) return \"no main camera\";\nvar sb = new System.Text.StringBuilder();\nsb.Append(\"isPlaying=\").Append(Application.isPlaying);\nsb.Append(\" pos=\").Append(cam.transform.position.ToString(\"F4\"));\nsb.Append(\" ortho=\").Append(cam.orthographicSize.ToString(\"F4\"));\nsb.Append(\" aspect=\").Append(cam.aspect.ToString(\"F4\"));\nsb.Append(\" rect=\").Append(cam.rect.ToString());\nsb.Append(\" pixelRect=\").Append(cam.pixelRect.ToString());\nsb.Append(\" screen=\").Append(Screen.width).Append(\"x\").Append(Screen.height);\nsb.Append(\" enabled=\").Append(cam.enabled);\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
