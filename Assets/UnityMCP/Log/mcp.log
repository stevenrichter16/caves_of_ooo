{"ts":"2026-08-08T16:58:23.953Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1311,"action":"execute","params":{"action":"execute","code":"// READ-ONLY census: which blueprints are the TOP visible entity of\n// cells that the sprite pass leaves as ASCII (no actor/fixture/ground\n// sprite claim)? Counts by blueprint name.\nvar zr = UnityEngine.Object.FindFirstObjectByType<CavesOfOoo.Rendering.ZoneRenderer>();\nif (zr == null || zr.CurrentZone == null) return \"no zone\";\nvar zone = zr.CurrentZone;\nvar counts = new System.Collections.Generic.Dictionary<string, int>();\nfor (int x = 0; x < CavesOfOoo.Core.Zone.Width; x++)\nfor (int y = 0; y < CavesOfOoo.Core.Zone.Height; y++)\n{\n    var cell = zone.GetCell(x, y);\n    var top = cell?.GetTopVisibleObject();\n    if (top == null) continue;\n    string bp = top.BlueprintName ?? \"(null)\";\n    // Skip things we KNOW claim sprites\n    if (CavesOfOoo.Rendering.EnvironmentSpriteRenderer.ResolveActorKind(bp)\n        != CavesOfOoo.Rendering.EnvironmentSpriteRenderer.ActorSpriteKind.None) continue;\n    if (CavesOfOoo.Rendering.EnvironmentSpriteRenderer.ResolveFixtureKind(bp)\n        != CavesOfOoo.Rendering.EnvironmentSpriteRenderer.EnvFixtureKind.None) continue;\n    if (CavesOfOoo.Rendering.EnvironmentSpriteRenderer.ResolveGroundMaterial(bp)\n        != CavesOfOoo.Rendering.EnvironmentSpriteRenderer.GroundMaterial.None) continue;\n    if (!counts.ContainsKey(bp)) counts[bp] = 0;\n    counts[bp]++;\n}\nvar sb = new System.Text.StringBuilder();\nforeach (var kvp in System.Linq.Enumerable.OrderByDescending(counts, k => k.Value))\n    sb.AppendLine(kvp.Key + \" x\" + kvp.Value);\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-08-08T16:58:33.798Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1039,"action":"execute","params":{"action":"execute","code":"return new { ka = true };","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-08-08T16:59:10.337Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1203,"action":"execute","params":{"action":"execute","code":"// READ-ONLY: which cells still show a MAIN-tilemap glyph (ASCII\n// residue) while sprite mode runs, and what entity/glyph is there?\nvar zr = UnityEngine.Object.FindFirstObjectByType<CavesOfOoo.Rendering.ZoneRenderer>();\nif (zr == null || zr.CurrentZone == null) return \"no zone\";\nvar zone = zr.CurrentZone;\nvar grid = UnityEngine.GameObject.Find(\"ZoneGrid\");\nif (grid == null) return \"no grid\";\nUnityEngine.Tilemaps.Tilemap main = null;\nforeach (var tm in grid.GetComponentsInChildren<UnityEngine.Tilemaps.Tilemap>())\n    if (tm.gameObject.name == \"Tilemap\") main = tm;\nif (main == null) {\n    var names = new System.Text.StringBuilder();\n    foreach (var tm in grid.GetComponentsInChildren<UnityEngine.Tilemaps.Tilemap>())\n        names.Append(tm.gameObject.name + \"; \");\n    return \"tilemaps: \" + names;\n}\nvar counts = new System.Collections.Generic.Dictionary<string, int>();\nint residue = 0;\nfor (int x = 0; x < CavesOfOoo.Core.Zone.Width; x++)\nfor (int ty = 0; ty < CavesOfOoo.Core.Zone.Height; ty++)\n{\n    var t = main.GetTile(new UnityEngine.Vector3Int(x, ty, 0));\n    if (t == null) continue;\n    residue++;\n    int zy = CavesOfOoo.Core.Zone.Height - 1 - ty;\n    var top = zone.GetCell(x, zy)?.GetTopVisibleObject();\n    string key = (top?.BlueprintName ?? \"(empty)\") + \" | tile:\" + t.name;\n    if (!counts.ContainsKey(key)) counts[key] = 0;\n    counts[key]++;\n}\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"ASCII residue cells: \" + residue);\nint shown = 0;\nforeach (var kvp in System.Linq.Enumerable.OrderByDescending(counts, k => k.Value))\n{ sb.AppendLine(kvp.Key + \" x\" + kvp.Value); if (++shown > 14) break; }\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-08-08T16:59:20.697Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1126,"action":"execute","params":{"action":"execute","code":"var zr = UnityEngine.Object.FindFirstObjectByType<CavesOfOoo.Rendering.ZoneRenderer>();\nvar zone = zr.CurrentZone;\nvar grid = UnityEngine.GameObject.Find(\"ZoneGrid\");\nUnityEngine.Tilemaps.Tilemap main = null;\nforeach (var tm in grid.GetComponentsInChildren<UnityEngine.Tilemaps.Tilemap>())\n    if (tm.gameObject.name == \"ZoneTilemap\") main = tm;\nvar counts = new System.Collections.Generic.Dictionary<string, int>();\nint residue = 0;\nfor (int x = 0; x < CavesOfOoo.Core.Zone.Width; x++)\nfor (int ty = 0; ty < CavesOfOoo.Core.Zone.Height; ty++)\n{\n    var t = main.GetTile(new UnityEngine.Vector3Int(x, ty, 0));\n    if (t == null) continue;\n    residue++;\n    int zy = CavesOfOoo.Core.Zone.Height - 1 - ty;\n    var top = zone.GetCell(x, zy)?.GetTopVisibleObject();\n    string key = (top?.BlueprintName ?? \"(empty)\") + \" | tile:\" + t.name;\n    if (!counts.ContainsKey(key)) counts[key] = 0;\n    counts[key]++;\n}\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"ASCII residue cells: \" + residue);\nint shown = 0;\nforeach (var kvp in System.Linq.Enumerable.OrderByDescending(counts, k => k.Value))\n{ sb.AppendLine(kvp.Key + \" x\" + kvp.Value); if (++shown > 14) break; }\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-08-08T16:59:34.940Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1068,"action":"execute","params":{"action":"execute","code":"return new { ka = true };","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-08-08T16:59:49.913Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1108,"action":"execute","params":{"action":"execute","code":"var zr = UnityEngine.Object.FindFirstObjectByType<CavesOfOoo.Rendering.ZoneRenderer>();\nvar zone = zr.CurrentZone;\nvar grid = UnityEngine.GameObject.Find(\"ZoneGrid\");\nUnityEngine.Tilemaps.Tilemap overlay = null;\nforeach (var tm in grid.GetComponentsInChildren<UnityEngine.Tilemaps.Tilemap>())\n    if (tm.gameObject.name == \"EnvironmentSpriteTilemap\") overlay = tm;\nvar sb = new System.Text.StringBuilder();\n// Player at zone (39,11). Print a 13-wide x 7-tall window of overlay\n// tile names (abbreviated), zone rows 8..14, cols 33..45.\nfor (int zy = 8; zy <= 14; zy++)\n{\n    for (int x = 33; x <= 45; x++)\n    {\n        int ty = CavesOfOoo.Core.Zone.Height - 1 - zy;\n        var t = overlay.GetTile(new UnityEngine.Vector3Int(x, ty, 0));\n        string n = t == null ? \"----\" : t.name;\n        if (n.Length > 10) n = n.Substring(0, 10);\n        sb.Append(n.PadRight(11));\n    }\n    sb.AppendLine();\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
