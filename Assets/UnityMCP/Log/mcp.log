{"ts":"2026-08-09T17:05:59.268Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1725,"action":"execute","params":{"action":"execute","code":"var gb = UnityEngine.Object.FindObjectsByType<CavesOfOoo.GameBootstrap>(UnityEngine.FindObjectsSortMode.None); if (gb.Length==0) return \"no bootstrap\"; var f = gb[0].GetType().GetField(\"_zoneManager\", System.Reflection.BindingFlags.NonPublic|System.Reflection.BindingFlags.Instance); var zm = f.GetValue(gb[0]) as CavesOfOoo.Core.OverworldZoneManager; if (zm==null) return \"no zm\"; var sb=new System.Text.StringBuilder(); int[,] coords = { {11,10},{12,10},{13,10},{14,10},{15,10},{10,11},{10,12},{10,13},{10,14},{9,9},{8,8},{7,7},{13,13},{14,14},{6,10},{10,6},{16,10},{10,16},{12,14},{14,12} }; int totalC=0, totalI=0, totalV=0, zones=0; for (int i=0;i<coords.GetLength(0);i++){ string id=\"Overworld.\"+coords[i,0]+\".\"+coords[i,1]+\".0\"; var z=zm.GetZone(id); if(z==null) continue; zones++; int c=0,it=0,val=0; foreach(var e in z.GetAllEntities()){ var cp=e.GetPart<CavesOfOoo.Core.ContainerPart>(); if(cp!=null){c++; it+=cp.Contents.Count; foreach(var item in cp.Contents){ var cm=item.GetPart<CavesOfOoo.Core.CommercePart>(); if(cm!=null) val+=cm.Value; } } var ph=e.GetPart<CavesOfOoo.Core.PhysicsPart>(); if(ph!=null&&ph.Takeable){ var cm2=e.GetPart<CavesOfOoo.Core.CommercePart>(); if(cm2!=null) val+=cm2.Value; } } totalC+=c; totalI+=it; totalV+=val; } return \"zones=\"+zones+\" containers=\"+totalC+\" containedItems=\"+totalI+\" totalSellValue=\"+totalV+\" | perZone: cont=\"+(zones>0?(totalC*100/zones)/100.0:0)+\" val=\"+(zones>0?totalV/zones:0);","safety_checks":true,"compiler":"auto"}}
