{"ts":"2026-08-11T01:59:32.667Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1694,"action":"execute","params":{"action":"execute","code":"\nvar invUI = UnityEngine.Object.FindFirstObjectByType<CavesOfOoo.Rendering.InventoryUI>();\nvar zr = UnityEngine.Object.FindFirstObjectByType<CavesOfOoo.Rendering.ZoneRenderer>();\nvar sb = new System.Text.StringBuilder();\nvar invTm = invUI != null ? invUI.Tilemap : null;\nsb.AppendLine(\"invTilemap=\" + (invTm != null ? invTm.gameObject.name : \"NULL\") + \"  paused=\" + (zr != null ? zr.Paused.ToString() : \"?\"));\nforeach (var tm in UnityEngine.Object.FindObjectsByType<UnityEngine.Tilemaps.Tilemap>(UnityEngine.FindObjectsSortMode.None)) {\n  var r = tm.GetComponent<UnityEngine.Tilemaps.TilemapRenderer>();\n  int count = 0; var b = tm.cellBounds;\n  foreach (var pos in b.allPositionsWithin) if (tm.HasTile(pos)) count++;\n  sb.AppendLine(tm.gameObject.name + \" | tiles=\" + count + \" | order=\" + (r != null ? r.sortingOrder : -999) + \" | active=\" + tm.gameObject.activeInHierarchy + \" | size=\" + b.size + \" | isInv=\" + (tm == invTm));\n}\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-08-11T02:00:27.633Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1578,"action":"execute","params":{"action":"execute","code":"\nvar invUI = UnityEngine.Object.FindFirstObjectByType<CavesOfOoo.Rendering.InventoryUI>();\nvar zr = UnityEngine.Object.FindFirstObjectByType<CavesOfOoo.Rendering.ZoneRenderer>();\nvar tm = invUI.Tilemap;\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"paused=\" + zr.Paused + \"  invIsOpen=\" + invUI.IsOpen);\nint lower = 0, upper = 0;\nfor (int y = 0; y <= 24; y++) for (int x = 0; x < 80; x++) if (tm.HasTile(new UnityEngine.Vector3Int(x,y,0))) lower++;\nfor (int y = 25; y <= 44; y++) for (int x = 0; x < 80; x++) if (tm.HasTile(new UnityEngine.Vector3Int(x,y,0))) upper++;\nsb.AppendLine(\"tilemap rows y=0..24 (world band): \" + lower + \" tiles\");\nsb.AppendLine(\"tilemap rows y=25..44 (UI top band): \" + upper + \" tiles\");\nsb.AppendLine(\"UI row 0 -> tilemap y=44 ; UI row 44 -> tilemap y=0\");\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-08-11T02:01:04.215Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1577,"action":"execute","params":{"action":"execute","code":"\nvar invUI = UnityEngine.Object.FindFirstObjectByType<CavesOfOoo.Rendering.InventoryUI>();\nvar zr = UnityEngine.Object.FindFirstObjectByType<CavesOfOoo.Rendering.ZoneRenderer>();\nvar tm = invUI.Tilemap;\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"paused=\" + zr.Paused + \"  invIsOpen=\" + invUI.IsOpen);\nint lower = 0, upper = 0;\nfor (int y = 0; y <= 24; y++) for (int x = 0; x < 80; x++) if (tm.HasTile(new UnityEngine.Vector3Int(x,y,0))) lower++;\nfor (int y = 25; y <= 44; y++) for (int x = 0; x < 80; x++) if (tm.HasTile(new UnityEngine.Vector3Int(x,y,0))) upper++;\nsb.AppendLine(\"tilemap rows y=0..24 (world band): \" + lower + \" tiles\");\nsb.AppendLine(\"tilemap rows y=25..44 (UI top band): \" + upper + \" tiles\");\nsb.AppendLine(\"UI row 0 -> tilemap y=44 ; UI row 44 -> tilemap y=0\");\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"}}
