{"ts":"2026-08-09T17:43:52.271Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1358,"action":"execute","params":{"action":"execute","code":"var gb = UnityEngine.Object.FindObjectsByType<CavesOfOoo.GameBootstrap>(UnityEngine.FindObjectsSortMode.None); if(gb.Length==0) return \"no bootstrap\"; var ff = gb[0].GetType().GetField(\"_factory\", System.Reflection.BindingFlags.NonPublic|System.Reflection.BindingFlags.Instance); var fac = ff.GetValue(gb[0]) as CavesOfOoo.Data.EntityFactory; if(fac==null) return \"no factory\"; string[] who = { \"Merchant\", \"SaccharineEnvoy\", \"Villager\", \"Innkeeper\", \"CaveHermit\", \"Tinker\", \"Quartermaster\", \"Farmer\", \"Scribe\", \"Mogu\", \"PaleCurator\", \"Marceline\", \"Warden\", \"Undertaker\", \"WellKeeper\", \"Elder\", \"GlassblownDrifter\", \"ChoirTendril\", \"PalimpsestEcho\", \"Weaponsmith\" }; var sb=new System.Text.StringBuilder(); int ok=0, bad=0; foreach(var n in who){ var e = fac.CreateEntity(n); if(e==null){ sb.Append(n+\"=NULL \"); bad++; continue; } var inv=e.GetPart<CavesOfOoo.Core.InventoryPart>(); int items = inv!=null?inv.Objects.Count:0; int dr = CavesOfOoo.Core.TradeSystem.GetDrams(e); bool can = CavesOfOoo.Core.ConversationManager.CanTrade(e); if(items>0 && can) ok++; else bad++; sb.Append(n+\"[\"+items+\" goods,\"+dr+\"dr,\"+(can?\"TRADE\":\"no\")+\"] \"); } return \"stocked=\"+ok+\" empty=\"+bad+\" :: \"+sb;","safety_checks":true,"compiler":"auto"}}
