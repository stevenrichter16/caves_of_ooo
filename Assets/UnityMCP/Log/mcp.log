{"ts":"2026-08-10T02:08:17.601Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":788,"action":"execute","params":{"action":"execute","code":"var res=\"reactions loaded at boot: \"+CavesOfOoo.Core.TileReactionSystem.IsInitialized+\" count=\"+CavesOfOoo.Core.TileReactionSystem.Count; var z=new CavesOfOoo.Core.Zone(); var v=new CavesOfOoo.Core.Entity{ID=\"v\",BlueprintName=\"v\"}; v.Tags[\"Creature\"]=\"\"; v.Statistics[\"Hitpoints\"]=new CavesOfOoo.Core.Stat{Owner=v,Name=\"Hitpoints\",BaseValue=200,Min=0,Max=200}; v.Statistics[\"HeatResistance\"]=new CavesOfOoo.Core.Stat{Owner=v,Name=\"HeatResistance\",BaseValue=0,Min=-100,Max=100}; v.AddPart(new CavesOfOoo.Core.RenderPart{DisplayName=\"v\"}); v.AddPart(new CavesOfOoo.Core.StatusEffectsPart()); z.AddEntity(v,5,5); CavesOfOoo.Core.ZoneTileStateSystem.WriteCoating(z,5,5,\"oil\",8,null,\"Oilmark\"); res += \"\\n  Oilmark wrote oil; hp=\"+v.GetStatValue(\"Hitpoints\"); CavesOfOoo.Core.ZoneTileStateSystem.WriteResidue(z,5,5,\"embers\",4,null,\"EmberSpit\"); int fired=CavesOfOoo.Core.TileReactionSystem.ResolveZone(z); res += \"\\n  EmberSpit wrote embers -> reactions fired: \"+fired; res += \"\\n  hp after: \"+v.GetStatValue(\"Hitpoints\")+\"  oil gone: \"+(!z.TileState.HasCoating(5,5,\"oil\"))+\"  smoke: \"+z.TileState.Cloud(5,5); var z2=new CavesOfOoo.Core.Zone(); z2.TileState.WriteCoating(3,3,\"water\",6); z2.TileState.AddCharge(3,3,1); int f2=CavesOfOoo.Core.TileReactionSystem.ResolveZone(z2); res += \"\\n  water+charge -> fired=\"+f2+\" water survives=\"+z2.TileState.HasCoating(3,3,\"water\")+\" charge spent=\"+(z2.TileState.Charge(3,3)==0); return res;","safety_checks":true,"compiler":"auto"}}
