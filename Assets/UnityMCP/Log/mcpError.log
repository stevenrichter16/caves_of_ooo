{"ts":"2026-07-23T15:41:25.477Z","tool":"execute_code","type":"tool","status":"ERROR","ms":479,"action":"execute","params":{"action":"execute","code":"\nusing CavesOfOoo.Core;\nusing CavesOfOoo.Diagnostics;\nusing System.Text;\n\nGasRegistry.Initialize(@\"{ \"\"Gases\"\":[\n  { \"\"Id\"\":\"\"fungal-spores\"\", \"\"GasType\"\":\"\"FungalSpores\"\",\n    \"\"Glyph\"\":\"\"°\"\", \"\"Color\"\":\"\"&G\"\",\n    \"\"DefaultDensity\"\":80, \"\"DefaultLevel\"\":1,\n    \"\"BehaviorKind\"\":\"\"FungalSpores\"\" } ] }\");\n\nvar sb = new StringBuilder();\nint badSeeds = 0;\nfor (int seed = 0; seed < 200; seed++)\n{\n    Diag.ResetAll();\n    var zone = new Zone(\"SeedProbe\" + seed);\n    var host = new Entity { ID = \"host\", BlueprintName = \"TestCreature\" };\n    host.Tags[\"Creature\"] = \"\";\n    void S(string n, int v, int max = 400) => host.Statistics[n] =\n        new Stat { Owner = host, Name = n, BaseValue = v, Min = -200, Max = max };\n    S(\"Hitpoints\", 200, 200); S(\"Toughness\", 14);\n    host.AddPart(new RenderPart { DisplayName = \"infected\" });\n    host.AddPart(new StatusEffectsPart());\n    zone.AddEntity(host, 5, 5);\n    var fx = new FungalInfectionEffect();\n    host.ApplyEffect(fx);\n    fx.TurnsInfected = 19;\n    var ctx = GameEvent.New(\"BeginTakeAction\");\n    ctx.SetParameter(\"Zone\", (object)zone);\n    fx.OnTurnStart(host, ctx);\n    ctx.Release();\n\n    int gasCountBefore = zone.GetEntitiesWithTag(\"Gas\").Count;\n\n    Diag.ResetAll();\n    GasSystem.SetRngForTests(new System.Random(seed));\n    GasSystem.OnTickEnd(zone);\n\n    var recs = DiagQuery.Apply(new DiagQuery.Filter\n    { Category = \"gas\", Kind = \"InfectionAlreadyPresent\", Limit = 5 }).Records;\n\n    if (recs.Count == 0)\n    {\n        badSeeds++;\n        sb.AppendLine($\"seed={seed} gasCountBefore={gasCountBefore} recs=0 (FAILS)\");\n    }\n}\nGasSystem.SetRngForTests(null);\nGasRegistry.ResetForTests();\nreturn $\"badSeeds={badSeeds}/200\\n\" + sb.ToString();\n","s