{"ts":"2026-07-23T15:41:25.477Z","tool":"execute_code","type":"tool","status":"ERROR","ms":479,"action":"execute","params":{"action":"execute","code":"\nusing CavesOfOoo.Core;\nusing CavesOfOoo.Diagnostics;\nusing System.Text;\n\nGasRegistry.Initialize(@\"{ \"\"Gases\"\":[\n  { \"\"Id\"\":\"\"fungal-spores\"\", \"\"GasType\"\":\"\"FungalSpores\"\",\n    \"\"Glyph\"\":\"\"°\"\", \"\"Color\"\":\"\"&G\"\",\n    \"\"DefaultDensity\"\":80, \"\"DefaultLevel\"\":1,\n    \"\"BehaviorKind\"\":\"\"FungalSpores\"\" } ] }\");\n\nvar sb = new StringBuilder();\nint badSeeds = 0;\nfor (int seed = 0; seed < 200; seed++)\n{\n    Diag.ResetAll();\n    var zone = new Zone(\"SeedProbe\" + seed);\n    var host = new Entity { ID = \"host\", BlueprintName = \"TestCreature\" };\n    host.Tags[\"Creature\"] = \"\";\n    void S(string n, int v, int max = 400) => host.Statistics[n] =\n        new Stat { Owner = host, Name = n, BaseValue = v, Min = -200, Max = max };\n    S(\"Hitpoints\", 200, 200); S(\"Toughness\", 14);\n    host.AddPart(new RenderPart { DisplayName = \"infected\" });\n    host.AddPart(new StatusEffectsPart());\n    zone.AddEntity(host, 5, 5);\n    var fx = new FungalInfectionEffect();\n    host.ApplyEffect(fx);\n    fx.TurnsInfected = 19;\n    var ctx = GameEvent.New(\"BeginTakeAction\");\n    ctx.SetParameter(\"Zone\", (object)zone);\n    fx.OnTurnStart(host, ctx);\n    ctx.Release();\n\n    int gasCountBefore = zone.GetEntitiesWithTag(\"Gas\").Count;\n\n    Diag.ResetAll();\n    GasSystem.SetRngForTests(new System.Random(seed));\n    GasSystem.OnTickEnd(zone);\n\n    var recs = DiagQuery.Apply(new DiagQuery.Filter\n    { Category = \"gas\", Kind = \"InfectionAlreadyPresent\", Limit = 5 }).Records;\n\n    if (recs.Count == 0)\n    {\n        badSeeds++;\n        sb.AppendLine($\"seed={seed} gasCountBefore={gasCountBefore} recs=0 (FAILS)\");\n    }\n}\nGasSystem.SetRngForTests(null);\nGasRegistry.ResetForTests();\nreturn $\"badSeeds={badSeeds}/200\\n\" + sb.ToString();\n","safety_checks":true,"compiler":"auto"},"error":"Compilation failed"}
{"ts":"2026-08-08T17:46:28.880Z","tool":"execute_code","type":"tool","status":"ERROR","ms":1128,"action":"execute","params":{"action":"execute","code":"var grid = UnityEngine.GameObject.Find(\"ZoneTilemap\");\nvar overlayTm = default(UnityEngine.Tilemaps.Tilemap);\nforeach (var tm in UnityEngine.Object.FindObjectsByType<UnityEngine.Tilemaps.Tilemap>(UnityEngine.FindObjectsSortMode.None))\n    if (tm.gameObject.name == \"EnvironmentSpriteTilemap\") overlayTm = tm;\nif (overlayTm == null) return \"overlay tilemap not found\";\nvar zone = CavesOfOoo.Core.ZoneManager.Instance != null ? CavesOfOoo.Core.ZoneManager.Instance.ActiveZone : null;\nif (zone == null) return \"no active zone\";\nint claims = 0, onUnexplored = 0, onNotVisible = 0, actorOnNotVisible = 0;\nvar sb = new System.Text.StringBuilder();\nfor (int x = 0; x < CavesOfOoo.Core.Zone.Width; x++)\nfor (int ty = 0; ty < CavesOfOoo.Core.Zone.Height; ty++)\n{\n    var t = overlayTm.GetTile(new UnityEngine.Vector3Int(x, ty, 0));\n    if (t == null) continue;\n    claims++;\n    int zy = CavesOfOoo.Core.Zone.Height - 1 - ty;\n    var cell = zone.GetCell(x, zy);\n    if (cell == null) continue;\n    if (!cell.Explored) { onUnexplored++; if (onUnexplored <= 5) sb.Append($\"unexplored claim {t.name}@({x},{zy}) \"); }\n    else if (!cell.IsVisible)\n    {\n        onNotVisible++;\n        bool actorTile = t.name == \"Player\" || t.name == \"Snapjaw\" || t.name == \"Villager\" || t.name == \"Merchant\" || t.name == \"Elder\" || t.name == \"Warden\" || t.name == \"VillageChild\" || t.name == \"Weaponsmith\" || t.name == \"Armorer\" || t.name == \"Apothecary\" || t.name == \"Arcanist\" || t.name == \"Provisioner\" || t.name.EndsWith(\"Hermit\");\n        if (actorTile) { actorOnNotVisible++; sb.Append($\"ACTOR-IN-FOG {t.name}@({x},{zy}) \"); }\n    }\n}\nreturn $\"claims={claims} onUnexplored={onUnexplored} onNotVisible={onNotVisible} actorInFog={actorOnNotVisible} :: {sb}\";","safety_checks":true,"compiler":"auto"},"error":"Compilation failed"}
{"ts":"2026-08-09T16:44:46.526Z","tool":"execute_code","type":"tool","status":"ERROR","ms":1253,"action":"execute","params":{"action":"execute","code":"var recs = CavesOfOoo.Diagnostics.Diag.Query(category: \"worldgen\", kind: \"ContainersPlaced\", limit: 30); var sb=new System.Text.StringBuilder(); sb.Append(\"records=\"+recs.Count+\" :: \"); foreach (var r in recs) sb.Append(r.PayloadJson+\" | \"); return sb.ToString();","safety_checks":true,"compiler":"auto"},"error":"Compilation failed"}
{"ts":"2026-08-09T16:45:08.149Z","tool":"execute_code","type":"tool","status":"ERROR","ms":1065,"action":"execute","params":{"action":"execute","code":"var zm = UnityEngine.Object.FindObjectsByType<CavesOfOoo.Core.OverworldZoneManager>(UnityEngine.FindObjectsSortMode.None); if (zm.Length==0) return \"no zm\"; var z = zm[0].GetZone(\"Overworld.12.10.0\"); if (z==null) return \"null zone\"; int cont=0,items=0; var sb=new System.Text.StringBuilder(); foreach (var e in z.GetAllEntities()) { var cp=e.GetPart<CavesOfOoo.Core.ContainerPart>(); if(cp==null) continue; cont++; items+=cp.Contents.Count; sb.Append(e.BlueprintName+\"[\"+cp.Contents.Count+\"] \"); } int armed=0; var asb=new System.Text.StringBuilder(); foreach (var e in z.GetAllEntities()) { if (e.GetPart<CavesOfOoo.Core.LoadoutPart>()==null) continue; armed++; var inv=e.GetPart<CavesOfOoo.Core.InventoryPart>(); asb.Append(e.BlueprintName+\"(eq\"+(inv!=null?inv.EquippedItems.Count:0)+\") \"); } return \"WILDERNESS \"+z.ZoneID+\": containers=\"+cont+\" items=\"+items+\" :: \"+sb+\" || armed=\"+armed+\" :: \"+asb;","safety_checks":true,"compiler":"auto"},"error":"Compilation failed"}
